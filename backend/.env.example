# ===============================================
# EasyFinePrint Backend Environment Variables
# ===============================================

# Cloudflare Workers AI Configuration (Gemma 4 26B A4B IT)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it

# MongoDB Atlas Free Tier (Persistent Store)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=easyfineprint

# CORS & Security (exact deployed frontend origin without trailing slash)
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development


# Network & Content Constraints (SSRF & Resource Limits)
MAX_FETCH_BYTES=5000000
FETCH_TIMEOUT_SECONDS=20
MAX_POLICY_CHARS=500000

# Error Monitoring (Optional, with PII redaction)
SENTRY_DSN=
