# ===============================================
# EasyFinePrint Backend Environment Variables
# ===============================================

# Google GenAI / Gemma Configuration (Gemini API Free Tier)
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# MongoDB Atlas Free Tier (Persistent Store)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=easyfineprint

# CORS & Security (exact deployed frontend origin without trailing slash)
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development

# Optional SerpApi URL Discovery (Quota-guarded, disabled by default)
SERPAPI_API_KEY=
SERPAPI_ENABLED=false
SERPAPI_MONTHLY_CAP=200
SERPAPI_HOURLY_CAP=40

# Network & Content Constraints (SSRF & Resource Limits)
MAX_FETCH_BYTES=2000000
FETCH_TIMEOUT_SECONDS=15
MAX_POLICY_CHARS=120000

# Error Monitoring (Optional, with PII redaction)
SENTRY_DSN=
